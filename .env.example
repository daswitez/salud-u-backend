# Copiar a .env y establecer una contraseña local antes de iniciar.
# No confirmar este archivo ni reutilizar esta contraseña fuera del entorno local.
DB_NAME=salud_u
# El migrador es dueño del esquema y Flyway; no lo usa la aplicación en tiempo de ejecución.
DB_MIGRATOR_USER=salud_u_migrator
DB_MIGRATOR_PASSWORD=change-this-migrator-password
# El runtime se crea durante la primera inicialización de PostgreSQL y no posee BYPASSRLS.
DB_APP_USER=salud_u_runtime
DB_APP_PASSWORD=change-this-runtime-password
DB_PORT=5432
BACKEND_PORT=8080
# Cambiar a false únicamente para desarrollo local por HTTP.
SESSION_COOKIE_SECURE=true

# Producción con compose.production.yaml y Caddy. Deben ser valores institucionales
# reales, DNS apuntando al servidor y una dirección de correo administrada.
PUBLIC_DOMAIN=salud-u.example.edu.bo
TLS_EMAIL=infraestructura@example.edu.bo

# N-03 y O-02: tareas programadas (recordatorios de bandeja y cierre nocturno de jornadas).
# compose.production.yaml las activa por defecto y compose.yaml las deja apagadas; descomentar solo para cambiar
# ese valor en este entorno.
# SALUD_U_SCHEDULING_ENABLED=false
# Cron Spring (segundos/minutos/horas/día/mes/día de semana), en America/La_Paz.
SALUD_U_REMINDER_CRON="0 */15 * * * *"
# Cierre de jornadas: vuelve a consolidar los siete días anteriores; por defecto a las 00:30.
SALUD_U_DAY_CLOSE_CRON="0 30 0 * * *"
